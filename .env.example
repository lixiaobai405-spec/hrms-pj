# ============================================
# HRMS 环境变量模板
# 使用方式：复制为 .env 并修改密码
#   cp .env.example .env
# ============================================

# MySQL 数据库初始化
MYSQL_DATABASE=hrms
MYSQL_USER=hrms_user
MYSQL_PASSWORD=Root@123456
MYSQL_ROOT_PASSWORD=Root@123456

# 后端连接（docker-compose 内部）
DB_HOST=db
DB_PORT=3306
DB_NAME=hrms
DB_USER=hrms_user
DB_PASSWORD=Root@123456
